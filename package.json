{
  "name": "bistro-do-cogumelo-magico",
  "private": true,
  "version": "0.4.0",
  "description": "Bistrô do Cogumelo Mágico — jogo cooperativo casual de cozinha e decoração (Three.js + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "app:sync": "npm run build && npx cap sync",
    "app:android": "npx cap open android",
    "app:ios": "npx cap open ios",
    "icons": "node scripts/icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosnakazawa/magic-mushroom.git"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
